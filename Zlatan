var HIST_LEVELS=(function(){
  var lvls=[];
  var opps=AI_OPPONENTS.beg.concat(AI_OPPONENTS.reg).concat(AI_OPPONENTS.pro).concat(AI_OPPONENTS.zlt);
  for(var i=0;i<50;i++){
    var prog=i/49;
    var stars=Math.min(10,Math.max(1,Math.round(1+prog*9)));
    var diffIdx=i<12?0:i<25?1:i<40?2:3;
    var oppIdx=Math.floor(prog*(opps.length-1));
    var coinReward=Math.round(200+prog*2800);
    lvls.push({
      num:i+1,stars:stars,diffIdx:diffIdx,
      opp:opps[Math.min(oppIdx,opps.length-1)],
      coinReward:coinReward,
      label:i<12?'Barrio':i<25?'Regional':i<40?'Nacional':'Mundial'
    });
  }
  return lvls;
})();

/* ── COMPUTE PLAYER BONUS ── */
function getSquadBonus(){
  /* Average OVR of squad gives bonus to save time and shoot accuracy */
  if(!H2.squad||H2.squad.length===0)return{saveBonus:0,shotBonus:0,avgOvr:50};
  var total=0,cnt=0;
  H2.squad.forEach(function(id){
    var p=ALL_PLAYERS.find(function(x){return x.id===id;});
    if(p){total+=p.ovr;cnt++;}
  });
  var avg=cnt?Math.round(total/cnt):50;
  /* Save bonus: better squad = more time to tap save circle (max +400ms) */
  var saveBonus=Math.round((avg-50)/50*400);
  /* Shot bonus: better squad = better chance of scoring (expressed as zone accuracy) */
  var shotBonus=(avg-50)/50*0.3; /* 0..0.3 bonus to not miss */
  return{saveBonus:saveBonus,shotBonus:shotBonus,avgOvr:avg};
}

