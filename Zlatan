#HI{background:radial-gradient(ellipse at 50% 20%,#1a2a0a,#050a02);display:flex;flex-direction:column;overflow:hidden;}
#hi-header{width:100%;display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:rgba(0,0,0,.4);flex-shrink:0;gap:6px;z-index:5;}
#hi-path{flex:1;overflow-y:auto;overflow-x:hidden;width:100%;padding:10px 14px 100px;-webkit-overflow-scrolling:touch;}
.hi-action-btn{position:absolute;width:58px;height:58px;border-radius:16px;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:8px;font-weight:900;z-index:30;box-shadow:0 4px 18px rgba(0,0,0,.5);transition:transform .12s;}
