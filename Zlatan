<title>Zlatan Penaltis Pro</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;touch-action:manipulation;-webkit-tap-highlight-color:transparent;}
html,body{width:100%;height:100%;overflow:hidden;font-family:Arial,sans-serif;background:#1a1a2e;}
.sc{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .22s;overflow-y:auto;}
.sc.on{opacity:1;pointer-events:all;}

/* MENU */
#MN{background:radial-gradient(ellipse at 50% 30%,#1a3a1a,#0a0a14);}
#mbg{position:absolute;inset:0;width:100%;height:100%;}
.mc{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;padding:20px 0;}
.L1{font-size:clamp(30px,8vw,52px);font-weight:900;color:#fff;line-height:1;text-shadow:0 3px 0 rgba(0,0,0,.4);}
.L2{font-size:clamp(30px,8vw,52px);font-weight:900;color:#FFD600;line-height:1;text-shadow:0 3px 0 #9a6c00,0 0 30px rgba(255,214,0,.3);}
.LS{font-size:10px;letter-spacing:4px;color:rgba(255,255,255,.35);margin:5px 0 14px;}
#mpc{border-radius:12px;margin-bottom:14px;box-shadow:0 6px 24px rgba(0,0,0,.5);}
.mbt{width:min(280px,84vw);height:52px;border-radius:14px;border:none;cursor:pointer;font-size:19px;font-weight:900;display:flex;align-items:center;justify-content:center;gap:9px;margin-bottom:10px;transition:transform .1s,box-shadow .1s;}
.mbt:active{transform:translateY(3px);}
.bt2p{background:linear-gradient(150deg,#2979FF,#1565C0);color:#fff;box-shadow:0 5px 0 #0d3d8a;}
.btai{background:linear-gradient(150deg,#FF6D00,#E64A19);color:#fff;box-shadow:0 5px 0 #8d2500;}
.btcp{background:linear-gradient(150deg,#FFD600,#FF8F00);color:#1a1209;box-shadow:0 5px 0 #c45a00;}

/* TEAM SELECT */
#TS,#AI_DIFF,#AI_TEAM,#AI_LVL{background:radial-gradient(ellipse at 50% 30%,#0d2b4a,#060e07);overflow-y:auto;}
.sel-wrap{display:flex;flex-direction:column;align-items:center;padding:16px 14px;gap:10px;width:100%;max-width:500px;margin:0 auto;}
.sel-title{font-size:22px;font-weight:900;color:#FFD600;text-align:center;text-shadow:0 2px 0 #9a6c00;}
.sel-sub{font-size:10px;color:rgba(255,255,255,.45);letter-spacing:3px;text-align:center;}
.teams-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;width:100%;}
.team-btn{height:72px;border-radius:11px;border:2px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transition:all .15s;}
.team-btn:active{transform:scale(.94);}.team-btn.sel{border-color:#FFD600;background:rgba(255,214,0,.18);}
.t-flag{font-size:24px;line-height:1;}
.t-name{font-size:7px;font-weight:900;color:rgba(255,255,255,.7);letter-spacing:.5px;text-align:center;}.team-btn.sel .t-name{color:#FFD600;}
.go-btn{width:100%;height:48px;border-radius:12px;border:none;cursor:pointer;background:linear-gradient(150deg,#FFD600,#FF8F00);color:#1a1209;font-size:18px;font-weight:900;box-shadow:0 4px 0 #c45a00;}
.go-btn:disabled{opacity:.25;pointer-events:none;}
.back-btn{width:100%;height:42px;border-radius:11px;border:1.5px solid rgba(255,255,255,.1);background:rgba(255,255,255,.07);color:rgba(255,255,255,.5);font-size:15px;font-weight:900;cursor:pointer;}

/* DIFFICULTY */
.diff-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;width:100%;}
.diff-btn{height:90px;border-radius:12px;border:2px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;transition:all .15s;padding:8px;}
.diff-btn:active{transform:scale(.94);}.diff-btn.sel{border-color:#FFD600;background:rgba(255,214,0,.15);}
.diff-icon{font-size:26px;line-height:1;}
.diff-name{font-size:13px;font-weight:900;color:#fff;}
.diff-info{font-size:9px;color:rgba(255,255,255,.5);text-align:center;line-height:1.3;}
.diff-btn.sel .diff-name{color:#FFD600;}.diff-btn.sel .diff-info{color:rgba(255,214,0,.7);}

/* LEVEL SELECT */
.lvl-scroll{width:100%;display:grid;grid-template-columns:repeat(5,1fr);gap:6px;max-height:300px;overflow-y:auto;padding:4px;}
.lvl-btn{height:50px;border-radius:10px;border:2px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;transition:all .12s;}
.lvl-btn.done{border-color:#69F0AE;background:rgba(105,240,174,.12);}
.lvl-btn.current{border-color:#FFD600;background:rgba(255,214,0,.18);}
.lvl-btn.locked{opacity:.3;pointer-events:none;}
.lvl-btn:active{transform:scale(.94);}
.lvl-num{font-size:16px;font-weight:900;color:#fff;}
.lvl-btn.done .lvl-num{color:#69F0AE;}.lvl-btn.current .lvl-num{color:#FFD600;}
.lvl-stars{font-size:9px;}
.lvl-progress{width:100%;background:rgba(255,255,255,.1);border-radius:20px;height:8px;overflow:hidden;}
.lvl-progress-bar{height:100%;background:linear-gradient(90deg,#FFD600,#FF8F00);border-radius:20px;transition:width .4s;}

/* GAME */
#GM{flex-direction:row;background:#1a1a2e;}
#lp{width:clamp(138px,22vw,195px);height:100%;flex-shrink:0;display:flex;flex-direction:column;justify-content:space-between;padding:10px 8px;background:rgba(0,0,0,.65);border-right:1px solid rgba(255,255,255,.06);}
.ss{display:flex;flex-direction:column;gap:6px;}
#grnd{font-size:7px;letter-spacing:2px;color:rgba(255,255,255,.28);text-align:center;font-weight:900;}
#lvl-info{font-size:8px;color:#FFD600;text-align:center;font-weight:900;letter-spacing:1px;min-height:12px;}
.tr{display:flex;align-items:center;gap:7px;padding:7px 8px;border-radius:10px;background:rgba(255,255,255,.06);}
.tb{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:900;color:#fff;flex-shrink:0;}
.tbb{background:#1565C0;}.tbo{background:#E64A19;}
.ti{flex:1;min-width:0;}
.tn{font-size:7px;letter-spacing:1px;color:rgba(255,255,255,.42);font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ts{font-size:30px;font-weight:900;line-height:1;}
.tsb{color:#90CAF9;}.tso{color:#FFAB76;}
.td{display:flex;gap:3px;flex-wrap:wrap;margin-top:2px;}
.hd{width:9px;height:9px;border-radius:50%;border:2px solid rgba(255,255,255,.18);background:rgba(0,0,0,.3);}
.hd.g{background:#69F0AE;border-color:#69F0AE;}.hd.m{background:#FF5252;border-color:#FF5252;}
.ct{display:flex;flex-direction:column;gap:5px;width:100%;}
#phl{font-size:12px;font-weight:900;color:#fff;text-align:center;line-height:1.25;min-height:32px;display:flex;align-items:center;justify-content:center;}
#phh{font-size:9px;color:rgba(255,255,255,.36);text-align:center;min-height:12px;line-height:1.3;}
#kzg{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;width:100%;}
.kz{height:40px;border-radius:8px;border:2px solid rgba(255,255,255,.16);background:rgba(255,255,255,.05);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;transition:all .12s;}
.kz:active{transform:scale(.94);}.kz.sel{border-color:#FFD600;background:rgba(255,214,0,.18);}
.kzl{font-size:7px;font-weight:900;color:rgba(255,255,255,.52);}.kz.sel .kzl{color:#FFD600;}
#bok{width:100%;height:40px;border-radius:10px;border:none;cursor:pointer;background:linear-gradient(150deg,#FFD600,#FF8F00);color:#1a1209;font-size:14px;font-weight:900;letter-spacing:1px;box-shadow:0 3px 0 #c45a00;transition:all .1s;}
#bok:active{transform:translateY(2px);box-shadow:0 1px 0 #c45a00;}#bok:disabled{opacity:.22;pointer-events:none;}
#cvw{flex:1;height:100%;overflow:hidden;position:relative;}
#gc{display:block;position:absolute;top:0;left:0;}

/* FLASH */
#fl{position:fixed;inset:0;z-index:80;pointer-events:none;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;transition:opacity .15s;}
#fl.on{opacity:1;}
#flb{position:absolute;inset:0;}
#flw{font-size:clamp(52px,10vw,80px);font-weight:900;color:#fff;text-align:center;letter-spacing:2px;text-shadow:0 4px 0 rgba(0,0,0,.25);position:relative;z-index:2;transform:scale(.3);transition:transform .24s cubic-bezier(.34,1.56,.64,1);line-height:1;}
#fl.on #flw{transform:scale(1);}
#fls{font-size:14px;font-weight:900;color:rgba(255,255,255,.88);position:relative;z-index:2;margin-top:6px;}

/* END */
#EN{background:radial-gradient(ellipse at 50% 35%,#1b5e20,#060e07);}
.ec{font-size:60px;margin-bottom:4px;}
.ew{font-size:clamp(20px,5vw,34px);font-weight:900;color:#FFD600;text-align:center;text-shadow:0 3px 0 #9a6c00;}
.escr{font-size:clamp(46px,10vw,62px);font-weight:900;color:#fff;text-shadow:0 3px 0 rgba(0,0,0,.4);margin:3px 0;}
.esub{font-size:11px;color:rgba(255,255,255,.38);letter-spacing:1px;margin-bottom:12px;}
.edr{display:flex;gap:16px;margin-bottom:12px;}
.edt{display:flex;flex-direction:column;align-items:center;gap:3px;}
.edtl{font-size:8px;letter-spacing:2px;color:rgba(255,255,255,.32);}
.edd{display:flex;gap:4px;}
.ed{width:12px;height:12px;border-radius:50%;border:2px solid rgba(255,255,255,.15);}
.ed.g{background:#69F0AE;border-color:#69F0AE;}.ed.m{background:#FF5252;border-color:#FF5252;}
.ebs{display:flex;flex-direction:column;gap:9px;width:min(250px,82vw);}
.eb{height:48px;border-radius:13px;border:none;cursor:pointer;font-size:18px;font-weight:900;letter-spacing:1px;}
.ebr{background:linear-gradient(150deg,#FFD600,#FF8F00);color:#1a1209;box-shadow:0 4px 0 #c45a00;}
.ebm{background:rgba(255,255,255,.07);color:rgba(255,255,255,.5);border:1.5px solid rgba(255,255,255,.1);}

/* COPA */
#CP{background:radial-gradient(ellipse at 50% 30%,#0d2b4a,#060e07);overflow-y:auto;}
.cp-wrap{display:flex;flex-direction:column;align-items:center;padding:16px 14px;gap:10px;width:100%;max-width:500px;margin:0 auto;}
#BR{background:radial-gradient(ellipse at 50% 30%,#0d2b4a,#060e07);overflow-y:auto;}
.br-wrap{display:flex;flex-direction:column;align-items:center;padding:16px 14px;gap:9px;width:100%;}
.br-title{font-size:22px;font-weight:900;color:#FFD600;text-align:center;}
.br-round{font-size:11px;color:rgba(255,255,255,.5);letter-spacing:3px;text-align:center;}
.br-match{width:100%;max-width:360px;background:rgba(255,255,255,.07);border-radius:13px;border:1px solid rgba(255,255,255,.1);overflow:hidden;}
.br-team{display:flex;align-items:center;gap:10px;padding:11px 14px;}
.br-team+.br-team{border-top:1px solid rgba(255,255,255,.08);}
.br-flag{font-size:22px;}.br-tname{font-size:14px;font-weight:900;color:#fff;flex:1;}
.play-btn{width:100%;max-width:360px;height:46px;border-radius:12px;border:none;cursor:pointer;background:linear-gradient(150deg,#2979FF,#1565C0);color:#fff;font-size:18px;font-weight:900;box-shadow:0 4px 0 #0d3d8a;}
#CW{background:radial-gradient(ellipse at 50% 35%,#1b5e20,#060e07);}
#BK{background:#CC0000;}
/* LEVEL WIN */
#LW{background:radial-gradient(ellipse at 50% 35%,#1a3a1a,#060e07);}
/* ── EXTRAS ── */
/* Streak banner */
#streak-banner{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0);z-index:70;pointer-events:none;text-align:center;transition:transform .25s cubic-bezier(.34,1.56,.64,1),opacity .3s;opacity:0;}
#streak-banner.show{transform:translate(-50%,-50%) scale(1);opacity:1;}
#streak-text{font-size:clamp(28px,7vw,52px);font-weight:900;color:#FF6D00;text-shadow:0 0 30px #FF6D00,0 3px 0 rgba(0,0,0,.4);letter-spacing:2px;}
#streak-sub{font-size:14px;font-weight:900;color:#FFD600;margin-top:4px;}
/* Particle canvas */
#fx-canvas{position:fixed;inset:0;pointer-events:none;z-index:60;}
/* Sudden death banner */
#sd-banner{position:fixed;inset:0;z-index:75;pointer-events:none;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .2s;}
#sd-banner.show{opacity:1;}
#sd-inner{font-size:clamp(26px,6vw,44px);font-weight:900;color:#FF5252;text-shadow:0 0 40px #FF5252,0 3px 0 rgba(0,0,0,.4);letter-spacing:3px;text-align:center;animation:sdpulse 0.6s ease-in-out infinite alternate;}
@keyframes sdpulse{from{transform:scale(1);}to{transform:scale(1.06);}}
/* Survive mode */
#SV{background:radial-gradient(ellipse at 50% 30%,#1a0a2e,#060010);}
/* Achievements popup */
#ach-pop{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(100px);z-index:90;background:linear-gradient(135deg,#1a1209,#2a1a00);border:2px solid #FFD600;border-radius:14px;padding:10px 18px;display:flex;align-items:center;gap:10px;box-shadow:0 4px 20px rgba(255,214,0,.35);transition:transform .35s cubic-bezier(.34,1.56,.64,1);min-width:240px;}
#ach-pop.show{transform:translateX(-50%) translateY(0);}
#ach-icon{font-size:28px;}
#ach-info{display:flex;flex-direction:column;gap:2px;}
#ach-title{font-size:11px;color:#FFD600;font-weight:900;letter-spacing:2px;}
#ach-name{font-size:14px;color:#fff;font-weight:900;}
/* XP bar in HUD */
#xp-bar-wrap{width:100%;height:6px;background:rgba(255,255,255,.1);border-radius:3px;overflow:hidden;margin-top:4px;}
#xp-bar{height:100%;background:linear-gradient(90deg,#FFD600,#FF8F00);border-radius:3px;transition:width .5s ease;}
#xp-label{font-size:7px;color:rgba(255,255,255,.4);text-align:center;letter-spacing:1px;}
/* Stats screen */
#ST{background:radial-gradient(ellipse at 50% 30%,#0d2b4a,#060e07);overflow-y:auto;}
.stat-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.07);}
.stat-lbl{font-size:12px;color:rgba(255,255,255,.55);}
.stat-val{font-size:16px;font-weight:900;color:#FFD600;}
/* Logros grid */
.ach-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:100%;}
.ach-card{height:80px;border-radius:10px;border:2px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;transition:all .2s;padding:4px;}
.ach-card.unlocked{border-color:#FFD600;background:rgba(255,214,0,.12);}
.ach-card.locked{opacity:.35;filter:grayscale(1);}
.ach-card-icon{font-size:22px;}
.ach-card-name{font-size:7px;font-weight:900;color:rgba(255,255,255,.6);text-align:center;}
.ach-card.unlocked .ach-card-name{color:#FFD600;}
/* Survive */
.sv-stat{font-size:clamp(48px,12vw,72px);font-weight:900;color:#FFD600;text-shadow:0 3px 0 #9a6c00;}
.sv-lbl{font-size:11px;color:rgba(255,255,255,.45);letter-spacing:3px;}
/* Menu extras buttons */
.mbt-sv{background:linear-gradient(150deg,#9C27B0,#6A1B9A);color:#fff;box-shadow:0 5px 0 #4A148C;}
.mbt-st{background:linear-gradient(150deg,#00796B,#004D40);color:#fff;box-shadow:0 5px 0 #002D26;}


