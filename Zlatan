  });
}

/* ── PLANTILLA ── */
function showPlantilla(){
  var wrap=el('pl-wrap');wrap.innerHTML='';
  var bonus=getSquadBonus();
  /* Header */
  var hdr=document.createElement('div');
  hdr.style.cssText='display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:10px;';
  hdr.innerHTML='<div style="font-size:16px;font-weight:900;color:#FFD600;">'+H2.teamName+'</div>'+
    '<div style="font-size:12px;font-weight:900;color:#69F0AE;">OVR '+bonus.avgOvr+'</div>';
  wrap.appendChild(hdr);
  var sub=document.createElement('div');sub.style.cssText='font-size:9px;color:rgba(255,255,255,.45);letter-spacing:2px;margin-bottom:8px;';
  sub.textContent='TU PLANTILLA ('+H2.ownedPlayers.length+' jugadores)';wrap.appendChild(sub);
  /* Squad slots */
  var sqSec=document.createElement('div');sqSec.style.cssText='width:100%;background:rgba(255,255,255,.05);border-radius:12px;padding:10px;margin-bottom:10px;';
  var sqTitle=document.createElement('div');sqTitle.style.cssText='font-size:9px;color:rgba(255,255,255,.45);letter-spacing:2px;margin-bottom:6px;';sqTitle.textContent='EQUIPO TITULAR';
  sqSec.appendChild(sqTitle);
  var sqGrid=document.createElement('div');sqGrid.style.cssText='display:grid;grid-template-columns:repeat(4,1fr);gap:5px;';
  H2.ownedPlayers.forEach(function(id){
    var p=ALL_PLAYERS.find(function(x){return x.id===id;});if(!p)return;
    var inSquad=H2.squad.indexOf(id)!==-1;
    var card=document.createElement('button');
    var rarC={legend:'#FF8F00',gold:'#FFD600',silver:'#C0C0C0',bronze:'#cd7f32'}[p.rarity]||'#888';
    card.style.cssText='height:60px;border-radius:9px;border:2px solid '+(inSquad?rarC:'rgba(255,255,255,.12)')+';background:'+(inSquad?rarC+'22':'rgba(255,255,255,.04)')+';cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;transition:all .12s;';
    card.innerHTML='<span style="font-size:10px;font-weight:900;color:'+rarC+';">'+p.ovr+'</span>'+
      '<span style="font-size:7px;color:#fff;text-align:center;line-height:1.2;">'+p.name.split(' ').pop()+'</span>'+
      '<span style="font-size:8px;">'+p.nat+'</span>'+
      (inSquad?'<span style="font-size:7px;color:'+rarC+';">✓</span>':'');
    card.onclick=function(pid,btn){return function(){toggleSquad(pid,btn);};}(id,card);
    sqGrid.appendChild(card);
  });
  sqSec.appendChild(sqGrid);wrap.appendChild(sqSec);
  show('PL');
}

function toggleSquad(id,btn){
  var idx=H2.squad.indexOf(id);
  if(idx!==-1){H2.squad.splice(idx,1);}
  else{if(H2.squad.length>=11){showStreakBanner('MAX 11','Ya tienes el equipo completo',1400);return;}H2.squad.push(id);}
  saveH2();showPlantilla();
}

/* ── MERCADO ── */
function showMercado(){
  var wrap=el('mk-wrap');wrap.innerHTML='';
  /* Coins */
  var coinBar=document.createElement('div');
  coinBar.style.cssText='display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:10px;';
  coinBar.innerHTML='<div style="font-size:16px;font-weight:900;color:#FFD600;">💰 '+H2.coins.toLocaleString()+' monedas</div>';
  wrap.appendChild(coinBar);
  /* COFRES */
  var chestsTitle=document.createElement('div');chestsTitle.style.cssText='font-size:9px;color:rgba(255,255,255,.45);letter-spacing:2px;margin-bottom:6px;';chestsTitle.textContent='COFRES SORPRESA';
  wrap.appendChild(chestsTitle);
  var chestsGrid=document.createElement('div');chestsGrid.style.cssText='display:grid;grid-template-columns:repeat(2,1fr);gap:8px;width:100%;margin-bottom:14px;';
  CHEST_TYPES.forEach(function(ct){
    var btn=document.createElement('button');
    btn.style.cssText='height:72px;border-radius:12px;border:2px solid '+ct.color+'44;background:'+ct.color+'11;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transition:all .14s;';
    btn.innerHTML='<span style="font-size:26px;">'+ct.icon+'</span>'+
      '<span style="font-size:11px;font-weight:900;color:'+ct.color+';">'+ct.name+'</span>'+
      '<span style="font-size:10px;color:rgba(255,255,255,.5);">💰 '+ct.price.toLocaleString()+'</span>';
    btn.onclick=function(type){return function(){buyChest(type);};}(ct.id);
    chestsGrid.appendChild(btn);
  });
  wrap.appendChild(chestsGrid);
  /* JUGADORES en venta (20 random, refreshed) */
  var mktTitle=document.createElement('div');mktTitle.style.cssText='font-size:9px;color:rgba(255,255,255,.45);letter-spacing:2px;margin-bottom:6px;';mktTitle.textContent='JUGADORES DISPONIBLES';
  wrap.appendChild(mktTitle);
  /* Deterministic daily refresh based on date */
  var day=Math.floor(Date.now()/86400000);
  var forSale=ALL_PLAYERS.filter(function(p){
    return H2.ownedPlayers.indexOf(p.id)===-1;
  }).sort(function(a,b){
    return seededRand(a.id+day*999)-seededRand(b.id+day*999+1);
  }).slice(0,24);
  var pGrid=document.createElement('div');pGrid.style.cssText='display:grid;grid-template-columns:repeat(3,1fr);gap:6px;width:100%;';
  forSale.forEach(function(p){
    var canAfford=H2.coins>=p.price;
    var rarC={legend:'#FF8F00',gold:'#FFD600',silver:'#C0C0C0',bronze:'#cd7f32'}[p.rarity]||'#888';
    var card=document.createElement('button');
    card.style.cssText='height:80px;border-radius:10px;border:2px solid '+(canAfford?rarC+'88':'rgba(255,255,255,.1)')+';background:'+(canAfford?rarC+'11':'rgba(0,0,0,.2)')+';cursor:'+(canAfford?'pointer':'default')+';display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;transition:all .12s;opacity:'+(canAfford?'1':'.5')+';';
    card.innerHTML='<span style="font-size:12px;">'+p.nat+'</span>'+
      '<span style="font-size:13px;font-weight:900;color:'+rarC+';">'+p.ovr+'</span>'+
      '<span style="font-size:7px;color:#fff;text-align:center;line-height:1.2;">'+p.name.split(' ').slice(-1)[0]+'</span>'+
      '<span style="font-size:8px;color:'+(canAfford?'#69F0AE':'#FF5252')+';">💰'+p.price.toLocaleString()+'</span>';
    if(canAfford)card.onclick=function(player,btn){return function(){buyPlayer(player,btn);};}(p,card);
    pGrid.appendChild(card);
  });
  wrap.appendChild(pGrid);
  show('MK');
}

function buyPlayer(p,btn){
  if(H2.coins<p.price){showStreakBanner('SIN MONEDAS','No tienes suficiente',1400);return;}
  H2.coins-=p.price;
  stats.coinsSpent=(stats.coinsSpent||0)+p.price;
  H2.ownedPlayers.push(p.id);
  saveH2();saveStats();sndLevelUp();
  showStreakBanner(p.name+' FICHADO!','💰 -'+p.price.toLocaleString(),1800);
  setTimeout(function(){showMercado();},500);
}

function buyChest(type){
  var ct=CHEST_TYPES.find(function(x){return x.id===type;});
  if(!ct||H2.coins<ct.price){showStreakBanner('SIN MONEDAS','No tienes suficiente para este cofre',1500);return;}
  H2.coins-=ct.price;
  stats.chestsOpened=(stats.chestsOpened||0)+1;
  stats.coinsSpent=(stats.coinsSpent||0)+ct.price;
  var result=openChest(type);
  saveH2();saveStats();sndLevelUp();
  if(result.type==='player'&&result.item){
    if(H2.ownedPlayers.indexOf(result.item.id)===-1)H2.ownedPlayers.push(result.item.id);
    saveH2();
    showChestResult(ct.icon,'¡JUGADOR!',result.item.nat+' '+result.item.name+' ('+result.item.ovr+' OVR)');
  } else if(result.type==='coins'){
    H2.coins+=result.coins;saveH2();
    showChestResult(ct.icon,'¡MONEDAS!','💰 +'+result.coins.toLocaleString()+' monedas');
  } else if(result.type==='power'){
    showChestResult(ct.icon,'¡PODER!','⚡ Zlatan Power desbloqueado');
  } else {
    showChestResult(ct.icon,'Sin suerte...','El cofre estaba vacío');
  }
}

function showChestResult(icon,title,sub){
  var overlay=document.createElement('div');
  overlay.style.cssText='position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.75);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;';
  overlay.innerHTML='<div style="font-size:72px;animation:pop .3s cubic-bezier(.34,1.56,.64,1);">'+icon+'</div>'+
    '<div style="font-size:26px;font-weight:900;color:#FFD600;text-shadow:0 3px 0 #9a6c00;">'+title+'</div>'+
    '<div style="font-size:16px;color:#fff;text-align:center;padding:0 20px;">'+sub+'</div>'+
    '<button onclick="this.parentNode.remove();showMercado();" style="margin-top:10px;padding:12px 32px;border-radius:12px;border:none;background:#FFD600;color:#1a1209;font-size:18px;font-weight:900;cursor:pointer;">CONTINUAR</button>';
  document.body.appendChild(overlay);
}

