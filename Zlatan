function startCopa(){
  if(copaSelTeam===null)return;
  var myTeam=COPA_TEAMS[copaSelTeam];
  /* Build 16-team bracket: player + 15 random opponents */
  var pool=COPA_TEAMS.filter(function(t,i){return i!==copaSelTeam;});
  for(var i=pool.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var tmp=pool[i];pool[i]=pool[j];pool[j]=tmp;}
  pool=pool.slice(0,15);
  copaResults={myTeam:myTeam,others:pool,roundIdx:0,groupWins:0,groupGamesPlayed:0,bracket:null};
  /* Build bracket: 4 groups of 4 (player in group A) */
  copaResults.bracket=buildBracket(myTeam,pool);
  var copaMidLevel=Math.round(DIFFS[copaDiff].levels*0.4);
  currentAIConfig=getAIConfig(copaDiff,Math.max(1,copaMidLevel));
  showBracketCanvas();
}

function buildBracket(myTeam,pool){
  /* 16 teams: player + 15 others → 4 groups of 4 */
  var all=[myTeam].concat(pool);
  var groups=[[],[],[],[]];
  groups[0].push(myTeam);
  var idx=0;
  for(var i=1;i<all.length;i++){
    var gi=i<4?0:Math.floor((i-1)/3)+0;
    /* distribute evenly: group 0 has player + 3 others, groups 1-3 have 4 each */
    if(groups[0].length<4&&i<=3)groups[0].push(all[i]);
    else if(groups[1].length<4&&i>3&&i<=7)groups[1].push(all[i]);
    else if(groups[2].length<4&&i>7&&i<=11)groups[2].push(all[i]);
    else groups[3].push(all[i]);
  }
  /* Group stage opponents for player = groups[0][1,2,3] */
  /* Bracket R16: winner of each group vs runner-up of another */
  return {groups:groups, groupOpponents:[groups[0][1],groups[0][2],groups[0][3]]};
}

function showBracketCanvas(){
  var cs=copaResults;
  var cnv=el('bk-canvas');
  var W2=cnv.offsetWidth||window.innerWidth;
  var H2=cnv.offsetHeight||(window.innerHeight-140);
  cnv.width=W2;cnv.height=H2;
  var c=cnv.getContext('2d');
  drawBracketCanvas(c,W2,H2,cs);
  /* Round label */
  var rl=el('bk-round-lbl');
  if(cs.roundIdx===0)rl.textContent='FASE DE GRUPOS — Partido '+(cs.groupGamesPlayed+1)+' de 3';
  else rl.textContent=['','OCTAVOS','CUARTOS','SEMIFINAL','GRAN FINAL'][cs.roundIdx]+' DE FINAL';
  /* Play button */
  var opp=getNextOpponent();
  el('bk-play').onclick=function(){playCopaMatch(opp);};
  show('BK');
}

function getNextOpponent(){
  var cs=copaResults;
  if(cs.roundIdx===0)return cs.bracket.groupOpponents[cs.groupGamesPlayed]||cs.others[0];
  return cs.others[cs.roundIdx+2]||cs.others[0];
}

function drawBracketCanvas(c,W2,H2,cs){
  /* Background stripes */
  c.fillStyle='#CC0000';c.fillRect(0,0,W2,H2);
  for(var i=0;i<W2;i+=60){c.fillStyle=i%120===0?'rgba(0,0,0,.08)':'rgba(0,0,0,.04)';c.fillRect(i,0,60,H2);}

  var groups=cs.bracket.groups;
  var pad=12,gw=(W2-pad*5)/4,gh=H2-pad*2;
  var rndNames=['A','B','C','D'];

  /* Draw 4 group columns */
  for(var g=0;g<4;g++){
    var gx=pad+g*(gw+pad),gy=pad;
    /* Group header */
    c.fillStyle='rgba(0,0,0,.35)';
    roundRectC(c,gx,gy,gw,gh,8);c.fill();
    c.fillStyle='rgba(255,214,0,.9)';
    c.font='bold 11px Arial';c.textAlign='center';c.textBaseline='middle';
    c.fillText('GRUPO '+rndNames[g],gx+gw/2,gy+14);
    /* Teams in group */
    var teams=groups[g]||[];
    var teamH=(gh-30)/4;
    for(var t=0;t<4;t++){
      var team=teams[t];if(!team)continue;
      var ty=gy+28+t*teamH;
      var isPlayer=g===0&&t===0;
      var isGroupOpp=g===0&&t>0&&cs.groupGamesPlayed>t-1;
      /* Row bg */
      c.fillStyle=isPlayer?'rgba(255,214,0,.25)':
                  (isGroupOpp&&cs.groupWins>0&&t<=cs.groupWins)?'rgba(105,240,174,.15)':
                  'rgba(255,255,255,.07)';
      roundRectC(c,gx+4,ty+2,gw-8,teamH-4,6);c.fill();
      /* Flag emoji */
      c.font=(teamH*0.55)+'px Arial';c.textAlign='left';c.textBaseline='middle';
      c.fillText(decodeHTMLEntities(team.flag),gx+10,ty+teamH/2);
      /* Name */
      c.fillStyle=isPlayer?'#FFD600':'#fff';
      c.font='bold '+(Math.min(teamH*.38,12))+'px Arial';
      c.textAlign='left';c.fillText(team.name,gx+teamH*0.7+8,ty+teamH/2);
      /* "TU" badge */
      if(isPlayer){
        c.fillStyle='#FFD600';c.font='bold 8px Arial';
        c.fillText('TU',gx+gw-24,ty+teamH/2);
      }
    }
  }

  /* Center trophy */
  c.font='32px Arial';c.textAlign='center';c.textBaseline='middle';
  c.fillText('&#x1F3C6;',W2/2,H2/2);
  c.fillStyle='rgba(255,214,0,.9)';c.font='bold 10px Arial';
  c.fillText('FINAL',W2/2,H2/2+24);
}

function decodeHTMLEntities(str){
  var d=document.createElement('div');d.innerHTML=str;return d.textContent||d.innerText||str;
}

function roundRectC(c,x,y,w,h,r){
  c.beginPath();c.moveTo(x+r,y);c.lineTo(x+w-r,y);c.arcTo(x+w,y,x+w,y+r,r);c.lineTo(x+w,y+h-r);c.arcTo(x+w,y+h,x+w-r,y+h,r);c.lineTo(x+r,y+h);c.arcTo(x,y+h,x,y+h-r,r);c.lineTo(x,y+r);c.arcTo(x,y,x+r,y,r);c.closePath();
}
