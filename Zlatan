/* ═══════════════════════════════════════════════════
   HISTORIA SETUP — team name, colors, difficulty
═══════════════════════════════════════════════════ */
var JERSEY_COLORS=[
  '#FFFFFF','#F8D800','#FF0000','#CC0000','#E65100','#FF6900',
  '#FF8F00','#FFD600','#006847','#1B5E20','#2E7D32','#4CAF50',
  '#003399','#0D47A1','#1565C0','#2979FF','#6CABDD','#74ACDF',
  '#6A1B9A','#9C27B0','#880E4F','#C2185B','#1a1209','#212121',
  '#37474F','#546E7A','#8B4513','#795548','#C68642','#FFCCBC'
];

var hsSelC1=0,hsSelC2=1,hsSelC3=11,hsSelDiff=0;

function buildColorGrid(gridId,selIdx,onSel){
  var g=el(gridId);g.innerHTML='';
  JERSEY_COLORS.forEach(function(col,i){
    var s=document.createElement('button');
    s.className='color-swatch'+(i===selIdx?' sel':'');
    s.style.background=col;
    s.onclick=function(){
      g.querySelectorAll('.color-swatch').forEach(function(x){x.classList.remove('sel');});
      s.classList.add('sel');onSel(i);updateJerseyPreview();
    };
    g.appendChild(s);
  });
}

function updateJerseyPreview(){
  var cv=el('jersey-preview');if(!cv)return;
  var c=cv.getContext('2d');
  c.clearRect(0,0,80,90);
  var c1=JERSEY_COLORS[hsSelC1],c2=JERSEY_COLORS[hsSelC2],c3=JERSEY_COLORS[hsSelC3];
  /* Shadow */
  c.fillStyle='rgba(0,0,0,.2)';c.beginPath();c.ellipse(40,86,22,6,0,0,Math.PI*2);c.fill();
  /* Shorts */
  c.fillStyle=c3;rr(c,22,52,36,18,4);c.fill();
  /* Jersey body */
  var g2=c.createLinearGradient(16,18,64,18);g2.addColorStop(0,c1);g2.addColorStop(1,c1);
  c.fillStyle=g2;rr(c,16,18,48,36,5);c.fill();
  /* Stripe */
  c.fillStyle=c2;c.fillRect(34,18,12,36);
  /* Arms */
  c.fillStyle=c1;rr(c,6,20,12,22,4);c.fill();
  rr(c,62,20,12,22,4);c.fill();
  /* Neck */
  c.fillStyle='#C68642';c.fillRect(33,12,14,8);
  /* Head */
  c.fillStyle='#C68642';c.beginPath();c.arc(40,8,10,0,Math.PI*2);c.fill();
  /* Hair */
  c.fillStyle='#1a1209';c.beginPath();c.arc(40,8,10,Math.PI,0);c.fill();
  c.beginPath();c.arc(40,-2,5,0,Math.PI*2);c.fill();
  var nm=el('hs-name')&&el('hs-name').value?el('hs-name').value.trim():'Mi Equipo';
  el('hs-preview-name').textContent=nm||'Mi Equipo';
}

function buildHSDiffGrid(){
  var g=el('hs-diff-grid');if(!g)return;g.innerHTML='';
  DIFFS.forEach(function(d,i){
    var b=document.createElement('button');b.className='hi-diff-btn'+(i===hsSelDiff?' sel':'');
    b.innerHTML='<span class="hi-diff-icon">'+d.icon+'</span><span class="hi-diff-name">'+d.name+'</span><span class="hi-diff-info">'+d.desc.replace('\n','<br>')+'</span>';
    b.onclick=function(){
      g.querySelectorAll('.hi-diff-btn').forEach(function(x){x.classList.remove('sel');});
      b.classList.add('sel');hsSelDiff=i;
    };
    g.appendChild(b);
  });
}

function checkHSReady(){
  var nm=el('hs-name')&&el('hs-name').value.trim();
  if(el('hs-go'))el('hs-go').disabled=!nm||nm.length<2;
  updateJerseyPreview();
}

function showHistoriaSetupFull(isEdit){
  hsSelC1=H2.colorIdx1||0;
  hsSelC2=H2.colorIdx2||1;
  hsSelC3=H2.colorIdx3||11;
  hsSelDiff=H2.histDiff||0;
  buildColorGrid('hs-color1-grid',hsSelC1,function(i){hsSelC1=i;});
  buildColorGrid('hs-color2-grid',hsSelC2,function(i){hsSelC2=i;});
  buildColorGrid('hs-color3-grid',hsSelC3,function(i){hsSelC3=i;});
  buildHSDiffGrid();
  if(el('hs-name')){
    el('hs-name').value=isEdit?(H2.teamName||''):'';
    el('hs-name').oninput=checkHSReady;
  }
  el('hs-go').textContent=isEdit?'GUARDAR CAMBIOS ✓':'COMENZAR HISTORIA ⚡';
  el('hs-go').onclick=function(){saveHSProfile(isEdit);};
  updateJerseyPreview();
  checkHSReady();
  show('HS');
  setTimeout(function(){try{el('hs-name').focus();}catch(e){}},350);
}

function saveHSProfile(isEdit){
  var nm=el('hs-name').value.trim();
  if(!nm||nm.length<2)return;
  H2.teamName=nm;
  H2.colorIdx1=hsSelC1;H2.colorIdx2=hsSelC2;H2.colorIdx3=hsSelC3;
  H2.histDiff=hsSelDiff;
  H2.unlocked=true;
  saveH2();sndLevelUp();
  renderHistoriaPath();show('HI');
}

/* Build custom team object from H2 colors */
function getHistoriaTeam(){
  var c1=JERSEY_COLORS[H2.colorIdx1||0];
  var c2=JERSEY_COLORS[H2.colorIdx2||1];
  var c3=JERSEY_COLORS[H2.colorIdx3||11];
  var myBase=TEAMS[profile.teamIdx]||TEAMS[0];
  return{
    name:(H2.teamName||profile.nick||'Mi Equipo').substring(0,12),
    flag:myBase.flag,
    j:c1,j2:c2,s:c3,
    sk:'#C68642',hr:'#1a1209',gl:'#C68642'
