/* AI pick — uses config for smarter behavior */
function aiPickKeeper(){
  /* With keeperAcc probability, pick the zone the human usually shoots */
  if(!currentAIConfig||Math.random()>currentAIConfig.keeperAcc)return Math.floor(Math.random()*6);
  /* "smart" pick: random but weighted toward center zones */
  var weights=[1,2,1,1,2,1];var total=8,r=Math.random()*total,cum=0;
  for(var i=0;i<6;i++){cum+=weights[i];if(r<cum)return i;}
  return 0;
}
function aiPickShooter(){
  if(!currentAIConfig||Math.random()>currentAIConfig.shooterSmart)return Math.floor(Math.random()*6);
