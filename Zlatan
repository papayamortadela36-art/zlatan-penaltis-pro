var fxCv=document.getElementById('fx-canvas');
var fxCtx=fxCv.getContext('2d');
var particles=[];
function resizeFX(){fxCv.width=window.innerWidth;fxCv.height=window.innerHeight;}
resizeFX();window.addEventListener('resize',resizeFX);

function spawnParticles(x,y,color,count){
  for(var i=0;i<(count||20);i++){
    var angle=Math.random()*Math.PI*2;
    var speed=2+Math.random()*6;
    particles.push({x:x,y:y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed-3,life:1,maxLife:0.6+Math.random()*0.6,r:3+Math.random()*5,color:color||'#FFD600'});
  }
}
function spawnGoalParticles(){
  var rect=gc.getBoundingClientRect();
  var cx=rect.left+rect.width/2, cy=rect.top+rect.height*.25;
  var cols=['#FFD600','#FF8F00','#fff','#69F0AE','#FF5252'];
  for(var i=0;i<60;i++){
    var color=cols[Math.floor(Math.random()*cols.length)];
    spawnParticles(cx+(Math.random()-.5)*rect.width*.5,cy+(Math.random()-.5)*40,color,0);
    /* overwrite last */
  }
  /* spawn them properly */
  particles=[];
  for(var i=0;i<60;i++){
    var color=cols[Math.floor(Math.random()*cols.length)];
    var angle=Math.random()*Math.PI*2;var speed=3+Math.random()*8;
    particles.push({x:cx+(Math.random()-.5)*rect.width*.4,y:cy,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed-4,life:1,maxLife:0.7+Math.random()*.5,r:3+Math.random()*6,color:color});
  }
}
function spawnNetShake(){ /* Net shake via particles along goal line */
  var rect=gc.getBoundingClientRect();
  if(!GL.x)return;
  for(var i=0;i<12;i++){
    var px=rect.left+GL.x+(Math.random()*GL.w);
    var py=rect.top+GL.y+(Math.random()*GL.h);
    particles.push({x:px,y:py,vx:(Math.random()-.5)*3,vy:(Math.random()-.5)*3-1,life:1,maxLife:0.3,r:4,color:'rgba(255,255,255,.6)'});
  }
}
function tickParticles(){
  if(!particles.length)return;
  fxCtx.clearRect(0,0,fxCv.width,fxCv.height);
  particles=particles.filter(function(p){
    p.x+=p.vx;p.y+=p.vy;p.vy+=0.25;p.life-=0.016/p.maxLife;
    if(p.life<=0)return false;
    fxCtx.globalAlpha=Math.max(0,p.life);
    fxCtx.fillStyle=p.color;
    fxCtx.beginPath();fxCtx.arc(p.x,p.y,p.r,0,Math.PI*2);fxCtx.fill();
    return true;
  });
  fxCtx.globalAlpha=1;
  if(particles.length)requestAnimationFrame(tickParticles);
  else fxCtx.clearRect(0,0,fxCv.width,fxCv.height);
}

