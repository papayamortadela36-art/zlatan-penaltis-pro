/* ── DIFFICULTY SCALING ── */
/* Returns AI config for a given difficulty + level */
function getAIConfig(diffIdx,level){
  var d=DIFFS[diffIdx];
  /* progress within diff: 0..1 */
  var prog=Math.min((level-1)/(d.levels-1),1);
  /* Save time decreases slightly as levels increase (but stays above min) */
  var saveTime=d.saveTime*(1-prog*.25); /* up to 25% faster at max level */
  /* AI keeper accuracy: how often AI picks the right zone */
  /* beg: 10-25%, reg: 20-45%, pro: 35-65%, zlt: 55-85% */
  var baseAcc=[.10,.20,.35,.55][diffIdx];
  var maxAcc=[.25,.45,.65,.85][diffIdx];
  var keeperAcc=baseAcc+prog*(maxAcc-baseAcc);
  /* AI shooter: how often AI picks a zone the human can't cover */
  /* beg: pure random, zlt: very smart */
  var shooterSmart=[0,.15,.35,.60][diffIdx]+prog*[0,.10,.20,.25][diffIdx];
  /* Get opponent */
  var opps=AI_OPPONENTS[d.id];
  var oppIdx=Math.floor(prog*(opps.length-1));
  var opp=opps[Math.min(oppIdx,opps.length-1)];
  return{saveTime:Math.max(saveTime,100),keeperAcc:keeperAcc,shooterSmart:shooterSmart,opp:opp,level:level,diffIdx:diffIdx};
}

