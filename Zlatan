/* ── SAVE CIRCLE ── */
var saveCircle=null;

function startSaveChallenge(aiKickZone,saveTime){
  var kzc=zC(aiKickZone);
  var ox=(Math.random()-.5)*GL.w*.16;var oy=(Math.random()-.5)*GL.h*.2;
  var cx=Math.min(Math.max(kzc.x+ox,GL.x+38),GL.x+GL.w-38);
  var cy=Math.min(Math.max(kzc.y+oy,GL.y+38),GL.by-38);
  saveCircle={x:cx,y:cy,r:34,timeLeft:saveTime,totalTime:saveTime,done:false};
  el('phl').textContent='TAP EL CIRCULO';el('phh').textContent='Rapido!';
  gc.style.cursor='crosshair';gc.ontouchstart=onSaveTap;gc.onmousedown=onSaveTap;
  var last=performance.now();
  function tick(now){
    if(saveCircle.done)return;
    saveCircle.timeLeft-=(now-last);last=now;draw();
    if(saveCircle.timeLeft<=0){
      saveCircle.done=true;gc.ontouchstart=null;gc.onmousedown=null;gc.style.cursor='default';
      onSaveResult(false,aiKickZone);
    } else {requestAnimationFrame(tick);}
  }
  requestAnimationFrame(tick);
}

function onSaveTap(e){
  if(!saveCircle||saveCircle.done)return;e.preventDefault();
  var rect=gc.getBoundingClientRect(),px,py;
  if(e.touches){px=e.touches[0].clientX-rect.left;py=e.touches[0].clientY-rect.top;}
  else{px=e.clientX-rect.left;py=e.clientY-rect.top;}
  var dx=px-saveCircle.x,dy=py-saveCircle.y;
  if(Math.sqrt(dx*dx+dy*dy)<=saveCircle.r+10){
    saveCircle.done=true;cancelAnimationFrame(saveCircle._raf);
    gc.ontouchstart=null;gc.onmousedown=null;gc.style.cursor='default';
    onSaveResult(true,G.aiKickZone);
  }
}

function onSaveResult(saved,aiKickZone){
  saveCircle=null;
  var kzc=zC(aiKickZone),bsx=SP.x,bsy=SP.y+H*.015,ksx=KHX,ksy=KHY;
  G.kDir=aiKickZone%3===0?-1:aiKickZone%3===2?1:0;
  var ktx=saved?kzc.x:KHX+(Math.random()-.5)*GL.w*.3;
  var kty=saved?kzc.y:KHY;
  var t=0;
  function step(){
    t=Math.min(t+.048,1);var e=eio(t);
    G.ballX=lerp(bsx,kzc.x,e);G.ballY=lerp(bsy,kzc.y,e);
    G.keepX=lerp(ksx,ktx,e);G.keepY=lerp(kty===KHY?ksy:ksy,kty,e);
    G.kT=t;draw();
    if(t<1)requestAnimationFrame(step);else afterSave(!saved,kI());
  }
  requestAnimationFrame(step);
}

function afterSave(goal,ki){
  if(goal)G.scores[ki]++;
  G.history[ki].push(goal);updateHUD();draw();
  showFlash(goal,ki);
  setTimeout(function(){hideFlash();resetBK();G.round++;
    if(G.history[0].length>=TOTAL&&G.history[1].length>=TOTAL){endGame();return;}
    beginK();draw();},1900);
}

function drawSaveCircle(){
  if(!saveCircle||saveCircle.done)return;
  var sc=saveCircle,prog=sc.timeLeft/sc.totalTime;
  var pulse=0.93+0.07*Math.sin(Date.now()*.015);var cr=sc.r*pulse;
  ctx.save();
  ctx.strokeStyle='rgba(255,255,255,.25)';ctx.lineWidth=5;
  ctx.beginPath();ctx.arc(sc.x,sc.y,cr+9,0,Math.PI*2);ctx.stroke();
  var col=prog>.5?'#69F0AE':prog>.25?'#FFD600':'#FF5252';
  ctx.strokeStyle=col;ctx.lineWidth=5;
  ctx.beginPath();ctx.arc(sc.x,sc.y,cr+9,-Math.PI/2,-Math.PI/2+prog*Math.PI*2);ctx.stroke();
  ctx.fillStyle='rgba(255,255,255,.15)';ctx.beginPath();ctx.arc(sc.x,sc.y,cr,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='rgba(255,255,255,.8)';ctx.lineWidth=2.5;
  ctx.beginPath();ctx.arc(sc.x,sc.y,cr,0,Math.PI*2);ctx.stroke();
  ctx.fillStyle='#fff';ctx.font='bold '+Math.round(cr*.95)+'px Arial';
  ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('&#x1F9E4;',sc.x,sc.y);
  ctx.restore();
}

